# ==========================================
# WanderGo Backend - Environment Variables
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database (MongoDB)
DB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/WanderGo?retryWrites=true&w=majority

# JWT & Authentication
JWT_SECRET=secret
JWT_REFRESH_SECRET=refresh_secret
JWT_ACCESS_TOKEN_EXPIRE=5d
JWT_REFRESH_TOKEN_EXPIRE=30d
BCRYPT_SALT_ROUNDS=10
EXPRESS_SESSION_SECRET=your_secret_key

# Super Admin Initial Credentials (Seeded automatically)
SUPER_ADMIN_EMAIL=admin@wandergo.com
SUPER_ADMIN_PASSWORD=Admin@123456

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URI=http://localhost:5000/api/v1/auth/google/callback

# SSLCommerz Payment Gateway Configuration
SSL_STORE_ID=your_ssl_store_id
SSL_STORE_PASS=your_ssl_store_pass
SSL_PAYMENT_API=https://sandbox.sslcommerz.com/gwprocess/v4/api.php
SSL_VALIDATION_API=https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php
SSL_SUCCESS_BACKEND_URL=http://localhost:5000/api/v1/payment/success
SSL_FAIL_BACKEND_URL=http://localhost:5000/api/v1/payment/fail
SSL_CANCEL_BACKEND_URL=http://localhost:5000/api/v1/payment/cancel
SSL_SUCCESS_FRONTEND_URL=http://localhost:3000/payment/success
SSL_FAIL_FRONTEND_URL=http://localhost:3000/payment/fail
SSL_CANCEL_FRONTEND_URL=http://localhost:3000/payment/cancel

# Cloudinary (Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service (Nodemailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
